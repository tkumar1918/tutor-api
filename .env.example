# Copy this file to `.env` and tweak as needed.
# `.env` is gitignored — never commit real credentials.

# Backend → MySQL. Inside Docker Compose, the host is the service name `mysql`.
# If you run the backend on your host (not in compose) against the MySQL
# container, change `mysql` to `localhost`.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/tutor_api?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=root

# JWT signing key — base64-encoded, ≥ 512 bits (HS512).
# Generate a fresh one with:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=<base64-encoded-64-byte-secret>
JWT_EXPIRATION_MS=3600000
