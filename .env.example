# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit your real credentials.

# Backend → database. For Supabase, grab the JDBC string from
# Project Settings → Database → Connection string → JDBC.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=<your-supabase-password>

# JWT signing key — base64-encoded, ≥ 512 bits (HS512).
# Generate a fresh one with:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=<base64-encoded-64-byte-secret>
JWT_EXPIRATION_MS=3600000
