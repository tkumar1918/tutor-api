# =============================================================================
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.
#
# How `.env` gets loaded:
#   - `docker compose up`  → read automatically via env_file: in docker-compose.yml
#   - `./mvnw spring-boot:run` / IDE → NOT read automatically. Either:
#       a) export it yourself:  set -a; source .env; set +a; ./mvnw spring-boot:run
#       b) add the spring-dotenv dependency so Spring loads .env on its own
#          (see pom.xml note in the README).
# =============================================================================

# --- Profile ------------------------------------------------------------------
# dev = verbose logs, auto-DDL, seed data, Swagger on. prod = strict.
SPRING_PROFILE=dev

# --- Database -----------------------------------------------------------------
# Uses the MariaDB JDBC driver (org.mariadb.jdbc) — URLs are jdbc:mariadb://...
# Two common shapes:
#
#   Local MariaDB container (the `mariadb` service in docker-compose.yml):
#     DB_URL=jdbc:mariadb://localhost:3306/tutor_api?createDatabaseIfNotExist=true&serverTimezone=UTC
#     DB_USER=root
#     DB_PASS=root
#
#   Hosted MariaDB with TLS (RDS / DigitalOcean / Aiven MariaDB / etc):
#     DB_URL=jdbc:mariadb://<host>:<port>/<db>?sslMode=REQUIRED&serverTimezone=UTC
#     DB_USER=<db-user>
#     DB_PASS=<db-password>
DB_URL=jdbc:mariadb://<host>:<port>/<db>?sslMode=REQUIRED&serverTimezone=UTC
DB_USER=<db-user>
DB_PASS=<db-password>

# --- Security -----------------------------------------------------------------
# Base64-encoded, >= 512 bits (HS512).
# Generate a fresh one with:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=<base64-encoded-64-byte-secret>
JWT_EXPIRATION_MS=3600000

# --- CORS ---------------------------------------------------------------------
# Comma-separated. Optional in dev (defaults to localhost). REQUIRED in prod.
CORS_ALLOWED_ORIGINS=https://tutor.webspacehub.in
