# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real credentials.

# Backend → MySQL. Three common shapes:
#
#   Local MySQL container (Option B in README):
#     SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/tutor_api?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
#     DB_USER=root
#     DB_PASSWORD=root
#
#   Aiven free tier (or any hosted MySQL with TLS):
#     SPRING_DATASOURCE_URL=jdbc:mysql://<host>.aivencloud.com:<port>/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
#     DB_USER=avnadmin
#     DB_PASSWORD=<your-aiven-password>
#
#   AWS RDS / DigitalOcean / etc — same shape as Aiven; adjust host/port/db.
SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/<db>?sslMode=REQUIRED&serverTimezone=UTC
DB_USER=<db-user>
DB_PASSWORD=<db-password>

# JWT signing key — base64-encoded, ≥ 512 bits (HS512).
# Generate a fresh one with:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=<base64-encoded-64-byte-secret>
JWT_EXPIRATION_MS=3600000
